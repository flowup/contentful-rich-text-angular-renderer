{
  "name": "contentful-rich-text-angular-renderer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/contentful-rich-text-angular-renderer/src",
  "prefix": "cf",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:ng-packagr",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "tsConfig": "libs/contentful-rich-text-angular-renderer/tsconfig.lib.json",
        "project": "libs/contentful-rich-text-angular-renderer/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/contentful-rich-text-angular-renderer/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "cache": true,
      "inputs": ["default", "^default", { "externalDependencies": ["vitest"] }],
      "options": {
        "buildTarget": "contentful-rich-text-angular-renderer:build:development",
        "tsConfig": "libs/contentful-rich-text-angular-renderer/tsconfig.spec.json",
        "watch": false
      }
    }
  }
}
