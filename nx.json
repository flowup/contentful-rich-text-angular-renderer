{
  "defaultProject": "demo",
  "generators": {
    "@nx/angular": {
      "application": {
        "linter": "eslint"
      },
      "library": {
        "linter": "eslint"
      },
      "storybook-configuration": {
        "linter": "eslint"
      },
      "directive": {
        "type": "directive"
      },
      "service": {
        "type": "service"
      },
      "guard": {
        "typeSeparator": "."
      },
      "interceptor": {
        "typeSeparator": "."
      },
      "module": {
        "typeSeparator": "."
      },
      "pipe": {
        "typeSeparator": "."
      },
      "resolver": {
        "typeSeparator": "."
      }
    },
    "@nx/angular:application": {
      "style": "scss",
      "linter": "eslint"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "strict": true
    },
    "@nx/angular:component": {
      "style": "scss",
      "type": "component"
    },
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "parallel": 1,
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "lint": [
      {
        "filter": {
          "plugin": "@nx/eslint/plugin"
        },
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/eslint.config.mjs",
          {
            "externalDependencies": ["eslint"]
          }
        ]
      }
    ]
  },
  "useInferencePlugins": false,
  "defaultBase": "main",
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    }
  ],
  "release": {
    "projects": ["contentful-rich-text-angular-renderer"],
    "projectsRelationship": "independent",
    "releaseTag": {
      "pattern": "v{version}"
    },
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk",
      "adjustSemverBumpsForZeroMajorVersion": false
    },
    "changelog": {
      "projectChangelogs": {
        "file": "{workspaceRoot}/CHANGELOG.md",
        "createRelease": "github"
      }
    },
    "git": {
      "commitMessage": "chore(release): publish"
    }
  }
}
